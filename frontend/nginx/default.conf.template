# :8080 questionnaire app, :8081 dashboard app. Each forwards its own API path, like CloudFront in AWS.

upstream questionnaire_api {
  server ${QUESTIONNAIRE_API_UPSTREAM};
  keepalive 32;
}

upstream dashboard_api {
  server ${DASHBOARD_API_UPSTREAM};
  keepalive 16;
}

# Shared by both servers.
map $uri $static_cache_control {
  ~^/assets/  "public, max-age=31536000, immutable";
  default     "no-cache";
}

server {
  listen 8080;
  root /usr/share/nginx/questionnaire;
  gzip on;
  gzip_types application/json application/javascript text/css;

  location /api/questionnaire/ {
    proxy_pass http://questionnaire_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    add_header Cache-Control $static_cache_control;
    try_files $uri /index.html;
  }
}

server {
  listen 8081;
  root /usr/share/nginx/dashboard;
  gzip on;
  gzip_types application/json application/javascript text/css;

  location /api/dashboard/ {
    proxy_pass http://dashboard_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location / {
    add_header Cache-Control $static_cache_control;
    try_files $uri /index.html;
  }
}
